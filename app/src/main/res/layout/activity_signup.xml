<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".SignUpActivity">

    <TextView
        android:id="@+id/btn_back"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginTop="20dp"
        android:drawablePadding="4dp"
        android:text="@string/back_text"
        android:textColor="@color/primary_blue_start"
        android:textSize="17sp"
        app:drawableStartCompat="@drawable/ic_back_blue"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/btn_back">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Registration Form Section -->
            <LinearLayout
                android:id="@+id/layout_register_form"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="40dp"
                android:visibility="visible">

                <ImageView
                    android:id="@+id/iv_profile"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="Profile Picture"
                    android:src="@drawable/ic_add_photo" />

                <TextView
                    android:id="@+id/tv_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/title_create_account"
                    android:textColor="@color/text_title"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_subtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/subtitle_create_account"
                    android:textColor="@color/text_subtitle"
                    android:textSize="14sp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FDFDFD"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <!-- Full Name -->
                        <EditText
                            android:id="@+id/et_full_name"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:background="@drawable/bg_edittext"
                            android:drawableStart="@drawable/ic_user_purple"
                            android:drawablePadding="12dp"
                            android:hint="@string/hint_full_name"
                            android:inputType="textPersonName"
                            android:paddingHorizontal="16dp"
                            android:textColorHint="#BCBCBC" />

                        <!-- Email -->
                        <EditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_edittext"
                            android:drawableStart="@drawable/ic_email"
                            android:drawablePadding="12dp"
                            android:hint="@string/hint_email"
                            android:inputType="textEmailAddress"
                            android:paddingHorizontal="16dp"
                            android:textColorHint="#BCBCBC" />

                        <!-- Phone -->
                        <EditText
                            android:id="@+id/et_phone"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_edittext"
                            android:drawableStart="@drawable/ic_phone"
                            android:drawablePadding="12dp"
                            android:hint="@string/hint_phone"
                            android:inputType="phone"
                            android:paddingHorizontal="16dp"
                            android:textColorHint="#BCBCBC" />

                        <!-- Place -->
                        <EditText
                            android:id="@+id/et_place"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_edittext"
                            android:drawableStart="@drawable/ic_location"
                            android:drawablePadding="12dp"
                            android:hint="@string/hint_place"
                            android:inputType="text"
                            android:paddingHorizontal="16dp"
                            android:textColorHint="#BCBCBC" />

                        <!-- DOB Selection -->
                        <LinearLayout
                            android:id="@+id/layout_dob"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp"
                            android:background="@drawable/bg_edittext"
                            android:clickable="true"
                            android:focusable="true"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp">

                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:src="@drawable/ic_calendar"
                                app:tint="#A855F7" />

                            <TextView
                                android:id="@+id/tv_dob_value"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:text="Select Date of Birth"
                                android:textColor="#9CA3AF"
                                android:textSize="16sp" />
                        </LinearLayout>

                        <!-- Password -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp">

                            <EditText
                                android:id="@+id/et_password"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_edittext"
                                android:drawableStart="@drawable/ic_lock"
                                android:drawablePadding="12dp"
                                android:hint="@string/hint_password"
                                android:inputType="textPassword"
                                android:paddingHorizontal="16dp"
                                android:textColorHint="#BCBCBC" />

                            <ImageView
                                android:id="@+id/iv_toggle_password"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="16dp"
                                android:src="@drawable/ic_eye" />
                        </RelativeLayout>

                        <!-- Confirm Password -->
                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:layout_marginTop="12dp">

                            <EditText
                                android:id="@+id/et_confirm_password"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_edittext"
                                android:drawableStart="@drawable/ic_confirm_password"
                                android:drawablePadding="12dp"
                                android:hint="@string/hint_confirm_password"
                                android:inputType="textPassword"
                                android:paddingHorizontal="16dp"
                                android:textColorHint="#BCBCBC" />

                            <ImageView
                                android:id="@+id/iv_toggle_confirm_password"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_marginEnd="16dp"
                                android:src="@drawable/ic_eye" />
                        </RelativeLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_signup"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_button_blue"
                            android:text="@string/btn_create_account"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

            <!-- OTP Verification Section -->
            <LinearLayout
                android:id="@+id/layout_otp_verification"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="40dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/iv_otp_header"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="Phone Verification"
                    android:src="@drawable/ic_phone"
                    app:tint="@color/primary_blue_start" />

                <TextView
                    android:id="@+id/tv_otp_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Verify Mobile"
                    android:textColor="@color/text_title"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_otp_subtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginHorizontal="40dp"
                    android:gravity="center"
                    android:text="Enter the verification code sent to your phone number."
                    android:textColor="@color/text_subtitle"
                    android:textSize="14sp" />

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30dp"
                    android:layout_marginTop="24dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="#FDFDFD"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:gravity="center_horizontal">

                        <!-- Horizontal Row of 6 digits -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center"
                            android:layout_marginTop="10dp">

                            <EditText
                                android:id="@+id/et_otp_1"
                                android:layout_width="40dp"
                                android:layout_height="54dp"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_edittext"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_title" />

                            <EditText
                                android:id="@+id/et_otp_2"
                                android:layout_width="40dp"
                                android:layout_height="54dp"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_edittext"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_title" />

                            <EditText
                                android:id="@+id/et_otp_3"
                                android:layout_width="40dp"
                                android:layout_height="54dp"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_edittext"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_title" />

                            <EditText
                                android:id="@+id/et_otp_4"
                                android:layout_width="40dp"
                                android:layout_height="54dp"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_edittext"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_title" />

                            <EditText
                                android:id="@+id/et_otp_5"
                                android:layout_width="40dp"
                                android:layout_height="54dp"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_edittext"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_title" />

                            <EditText
                                android:id="@+id/et_otp_6"
                                android:layout_width="40dp"
                                android:layout_height="54dp"
                                android:layout_margin="3dp"
                                android:background="@drawable/bg_edittext"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLength="1"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/text_title" />
                        </LinearLayout>

                        <!-- Timer and Resend option -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginTop="20dp"
                            android:gravity="center">

                            <TextView
                                android:id="@+id/tv_otp_timer"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Resend code in 60s"
                                android:textColor="@color/text_subtitle"
                                android:textSize="14sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_otp_resend"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Resend Code"
                                android:textColor="@color/primary_blue_start"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                android:visibility="gone"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>

                        <!-- Test Code Badge -->
                        <LinearLayout
                            android:id="@+id/layout_test_otp_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_available"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="8dp"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_test_otp_badge"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Testing Code: ######"
                                android:textColor="#1E40AF"
                                android:textSize="13sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/btn_verify_otp"
                            android:layout_width="match_parent"
                            android:layout_height="58dp"
                            android:layout_marginTop="24dp"
                            android:background="@drawable/bg_button_blue"
                            android:text="Verify &amp; Register"
                            android:textAllCaps="false"
                            android:textColor="@color/white"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btn_otp_back_to_edit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:text="Back to Edit Details"
                            android:textColor="@color/primary_blue_start"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:clickable="true"
                            android:focusable="true" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>